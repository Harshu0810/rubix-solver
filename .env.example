# Copy this file to .env for local development (it's git-ignored), and set
# the same two values as Environment Variables in your Vercel project
# settings for production.
#
# Get these from your Supabase project: Dashboard → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is the "anon public" key — it's meant to be public
# and safe to ship in the client bundle. Do NOT use the "service_role" key
# here; that one bypasses Row Level Security and must never reach a browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: The admin email used to distinguish admin users.
# This must match the email you created in Supabase Authentication → Users.
VITE_ADMIN_EMAIL=admin@example.com
